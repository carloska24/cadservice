# Application
PORT=8080
NODE_ENV=development

# Database (GCP Cloud SQL or Local)
DATABASE_URL="postgresql://user:password@localhost:5432/cadservice_db?schema=public"

# Auth
JWT_SECRET="changeme_in_production_secret_key_12345"
JWT_EXPIRES_IN="1d"

# Google Cloud Storage
GCP_PROJECT_ID="cadservice-project-id"
GCP_STORAGE_BUCKET="cadservice-assets"
# Path to service account key json (if local)
GOOGLE_APPLICATION_CREDENTIALS="./gcp-key.json"
