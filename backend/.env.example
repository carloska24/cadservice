# Application
PORT=8080
NODE_ENV=development

# CORS - comma-separated list of allowed origins (only used in production)
# Example: https://cadservice.com.br,https://www.cadservice.com.br
CORS_ORIGINS="https://cadservice.com.br"

# Database (GCP Cloud SQL or Local)
# SECURITY: Use secrets manager in production. Never commit real credentials!
DATABASE_URL="postgresql://user:password@localhost:5432/cadservice_db?schema=public"

# Auth
# SECURITY: Generate a strong secret (32+ chars) for production: openssl rand -hex 32
JWT_SECRET="changeme_in_production_secret_key_12345"
JWT_EXPIRES_IN="1d"

# Google Cloud Storage
GCP_PROJECT_ID="cadservice-project-id"
GCP_STORAGE_BUCKET="cadservice-assets"
# Path to service account key json (if local)
GOOGLE_APPLICATION_CREDENTIALS="./gcp-key.json"

