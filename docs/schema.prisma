// This is a reference schema for the CADService Data Model
// Intended for use with NestJS + Prisma ORM + PostgreSQL on GCP

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  CLIENT
}

enum RequestStatus {
  PENDING
  REVIEWED
  QUOTED
  ARCHIVED
}

model User {
  id            String    @id @default(uuid()) // Recommend UUIDv7 in application layer if supported
  email         String    @unique
  passwordHash  String
  fullName      String
  role          UserRole  @default(CLIENT)
  companyName   String?
  phone         String?
  isActive      Boolean   @default(true)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  articles      Article[]
  budgetRequests BudgetRequest[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Service {
  id              String   @id @default(uuid())
  title           String
  slug            String   @unique
  shortDescription String
  fullDescription String   @db.Text
  category        String
  
  // Flexible storage for varying industrial specs
  technicalSpecs  Json?    
  
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  projects        PortfolioProject[]
  assets          Asset[] // Service images/manuals

  @@map("services")
}

model PortfolioProject {
  id              String   @id @default(uuid())
  title           String
  slug            String   @unique
  clientName      String?  // Optional for confidentiality
  description     String   @db.Text
  completionDate  DateTime?
  isFeatured      Boolean  @default(false)
  
  serviceId       String
  service         Service  @relation(fields: [serviceId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  assets          Asset[]

  @@map("portfolio_projects")
}

model Article {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  excerpt     String    @db.Text
  content     String    @db.Text
  publishedAt DateTime?
  tags        String[]
  
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("articles")
}

model BudgetRequest {
  id                 String        @id @default(uuid())
  requesterName      String
  requesterEmail     String
  requesterPhone     String?
  company            String?
  projectDescription String        @db.Text
  status             RequestStatus @default(PENDING)
  adminNotes         String?       @db.Text

  userId             String?       // Optional link to registered user
  user               User?         @relation(fields: [userId], references: [id])

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // Relations
  attachments        Asset[]

  @@map("budget_requests")
}

model Asset {
  id          String   @id @default(uuid())
  url         String
  path        String   // GCS Storage Path
  mimeType    String
  sizeBytes   Int
  bucket      String
  
  // Polymorphic-like associations (simplified for relational integrity)
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id])
  
  projectId   String?
  project     PortfolioProject? @relation(fields: [projectId], references: [id])
  
  requestId   String?
  request     BudgetRequest? @relation(fields: [requestId], references: [id])

  createdAt   DateTime @default(now())

  @@map("assets")
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String   // CREATE, UPDATE, DELETE, LOGIN
  entityType  String   // 'Service', 'User', etc.
  entityId    String   // The ID of the affected entity
  changes     Json?    // { before: ..., after: ... }
  ipAddress   String?
  userAgent   String?

  userId      String?
  user        User?    @relation(fields: [userId], references: [id])

  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}
